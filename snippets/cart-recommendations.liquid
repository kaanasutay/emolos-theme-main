{%- liquid
  assign want_oversized = false
  assign want_polo = false
  assign want_modal = false
  assign want_jacket = false
  assign want_hoodie = false
  assign want_jogger = false
  assign cart_product_ids = '|'

  for item in cart.items
    assign cart_product_ids = cart_product_ids | append: item.product_id | append: '|'
    assign title_key = item.product.title | downcase
    assign handle_key = item.product.handle | downcase
    assign type_key = item.product.type | downcase
    assign tag_text = item.product.tags | join: ' ' | downcase
    assign blob = title_key | append: ' ' | append: handle_key | append: ' ' | append: type_key | append: ' ' | append: tag_text

    if blob contains 'short'
      assign want_modal = true
    elsif blob contains 'distressed' or blob contains 'jacquard'
      assign want_modal = true
      assign want_jogger = true
    elsif blob contains 'hoodie'
      assign want_jogger = true
    elsif blob contains 'jogger' or blob contains 'sweatpant'
      assign want_hoodie = true
    elsif blob contains 'chino'
      assign want_polo = true
    elsif blob contains 'cargo pant' or blob contains 'cargo-pant'
      assign want_oversized = true
    elsif blob contains 'relaxed'
      assign want_oversized = true
    elsif blob contains 'carpenter'
      assign want_oversized = true
    elsif blob contains 'slim fit jean' or blob contains 'slim-fit-jean'
      assign want_modal = true
      assign want_jacket = true
    elsif blob contains 'spray'
      assign want_modal = true
      assign want_jacket = true
    endif
  endfor

  assign outfit_plan = ''
  if want_oversized
    assign outfit_plan = outfit_plan | append: 'oversized|'
  endif
  if want_polo
    assign outfit_plan = outfit_plan | append: 'polo|'
  endif
  if want_modal
    assign outfit_plan = outfit_plan | append: 'modal|'
  endif
  if want_jacket
    assign outfit_plan = outfit_plan | append: 'jacket|'
  endif
  if want_hoodie
    assign outfit_plan = outfit_plan | append: 'hoodie|'
  endif
  if want_jogger
    assign outfit_plan = outfit_plan | append: 'jogger|'
  endif

  assign outfit_fallback = 'oversized|polo|modal|jacket|hoodie|jogger|'
  assign shown_ids = cart_product_ids
  assign shown_count = 0
-%}
{%- capture outfit_items -%}
  {%- for pass in (1..2) -%}
    {%- liquid
      if pass == 1
        assign pass_plan = outfit_plan
        if pass_plan == blank
          assign pass_plan = outfit_fallback
        endif
      elsif shown_count > 0 or outfit_plan == blank
        break
      else
        assign pass_plan = outfit_fallback
      endif
      assign outfit_groups = pass_plan | split: '|'
    -%}
    {%- for group in outfit_groups -%}
      {%- if group == blank or shown_count >= 12 -%}
        {%- continue -%}
      {%- endif -%}
      {%- liquid
        assign pool = blank
        case group
          when 'oversized', 'modal'
            assign pool = collections['essential-t-shirt-men'].products
          when 'polo'
            assign pool = collections['polo-shirt'].products
          when 'jacket'
            assign pool = collections['denim-jacket'].products
          when 'hoodie'
            assign pool = collections['hoodies'].products
          when 'jogger'
            assign pool = collections['joggers'].products
        endcase
      -%}
      {%- for outfit_product in pool -%}
        {%- if shown_count >= 12 -%}
          {%- break -%}
        {%- endif -%}
        {%- liquid
          assign include_product = false
          assign outfit_title = outfit_product.title | downcase
          case group
            when 'oversized'
              if outfit_title contains 'oversized'
                assign include_product = true
              endif
            when 'modal'
              if outfit_title contains 'modal' and outfit_title contains 't-shirt'
                unless outfit_title contains 'long sleeve'
                  assign include_product = true
                endunless
              endif
            when 'polo'
              if outfit_title contains 'polo'
                assign include_product = true
              endif
            when 'jacket'
              if outfit_title contains 'denim jacket'
                unless outfit_title contains 'distressed' or outfit_title contains 'jacquard'
                  assign include_product = true
                endunless
              endif
            when 'hoodie'
              if outfit_title contains 'hoodie'
                assign include_product = true
              endif
            when 'jogger'
              if outfit_title contains 'jogger' or outfit_title contains 'sweatpant'
                assign include_product = true
              endif
          endcase
          assign product_token = '|' | append: outfit_product.id | append: '|'
        -%}
        {%- if include_product and outfit_product.featured_image -%}
          {%- unless shown_ids contains product_token -%}
          {%- render 'cart-recommendation-card', recommendation: outfit_product -%}
          {%- liquid
            assign shown_count = shown_count | plus: 1
            assign shown_ids = shown_ids | append: outfit_product.id | append: '|'
          -%}
          {%- endunless -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endfor -%}
  {%- endfor -%}
{%- endcapture -%}
{%- assign outfit_count = outfit_items | split: 'cart-recommendations__item-wrapper' | size | minus: 1 -%}
<cart-recommendations
  class="cart-recommendations {{ class }}{% if outfit_count < 1 %} hidden{% endif %}"
  data-outfit="ready"
  data-url="{{- routes.product_recommendations_url -}}?section_id={{- section.id -}}&product_id={{- cart.items[0].product_id -}}&limit=8&intent=related"
>
  <div class="cart-recommendations__head">
    <h5 class="cart-recommendations__title">
      {{- 'cart.you_may_like' | t -}}
    </h5>
    <div class="cart-recommendations__nav">
      <button
        class="cart-recommendations__arrow cart-recommendations__arrow--prev"
        type="button"
        data-rec-prev
        aria-label="{{- 'actions.previous' | t -}}"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M10.5 3L5.5 8L10.5 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button
        class="cart-recommendations__arrow cart-recommendations__arrow--next"
        type="button"
        data-rec-next
        aria-label="{{- 'actions.next' | t -}}"
      >
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
          <path d="M5.5 3L10.5 8L5.5 13" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="cart-recommendations__body swiper">
    <div class="cart-recommendations__items swiper-wrapper" data-recommendations>
      {{- outfit_items -}}
    </div>
  </div>
</cart-recommendations>
