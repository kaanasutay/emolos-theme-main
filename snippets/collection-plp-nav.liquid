{%- comment -%}
  Nude Project-style collection listing header:
  top category strip, title + count, Filter | Sort, subcategory tabs.
{%- endcomment -%}

{%- liquid
  assign plp_menu = section.settings.plp_menu
  assign sub_links = nil
  assign view_all_url = nil
  assign view_all_title = nil
  assign view_all_current = false
  assign active_filter_count = 0

  if collection.filters != blank
    for filter in collection.filters
      assign active_filter_count = active_filter_count | plus: filter.active_values.size
    endfor
  endif

  if plp_menu != blank
    for link in plp_menu.links
      if link.current and link.links.size > 0
        assign sub_links = link.links
        assign view_all_url = link.url
        assign view_all_title = link.title
        assign view_all_current = true
      elsif link.child_current or link.child_active
        assign sub_links = link.links
        assign view_all_url = link.url
        assign view_all_title = link.title
        assign view_all_current = false
      endif
    endfor

    if sub_links == nil and plp_menu.links.size > 0
      assign sub_links = plp_menu.links
      assign view_all_url = routes.all_products_collection_url
      if collection.handle == 'all' or collection.handle == 'all-products'
        assign view_all_current = true
      endif
    endif
  endif

  assign product_count = collection.products_count | default: 0
  assign plp_seen = '|'
  if plp_menu != blank
    for link in plp_menu.links
      assign plp_seen = plp_seen | append: link.url | append: '|'
      if link.object.handle != blank
        assign plp_seen = plp_seen | append: link.object.handle | append: '|'
      endif
    endfor
  endif
-%}

{{- 'section-collection-plp.css' | asset_url | stylesheet_tag -}}

<div class="collection-plp collection-sticky-header-wrapper">
  <nav class="collection-plp__menu" aria-label="{{- collection.title | escape -}}">
    <ul class="collection-plp__menu-list list-unstyled">
      {%- liquid
        assign plp_nav_items = 'All Products|all-products|all||New Arrivals|new-arrivals||Best Sellers|best-sellers||Jeans|jeans||Jackets|denim-jacket|jackets||Hoodies|hoodies||Joggers|joggers|mens-joggers||T-Shirts|essential-t-shirt-men|t-shirts||Chino Pants|chino-pants|chinos||Polo Shirts|polo-shirt|polo-shirts||Shorts|mens-denim-shorts|shorts||Cargo pants|cargo-pants-for-men|cargo-pants' | split: '||'
        assign jeans_family = 'jeans|slim-fit-jeans|carpenter-jeans|carpenter-jeans-men|spray-on-jeans|relaxed-fit-jeans|relaxed-jeans' | split: '|'
        assign on_jeans_family = false
        if jeans_family contains collection.handle
          assign on_jeans_family = true
        endif
      -%}
      {%- for plp_nav_item in plp_nav_items -%}
        {%- liquid
          assign plp_nav_parts = plp_nav_item | split: '|'
          assign plp_nav_title = plp_nav_parts | first
          assign plp_nav_url = '/collections/' | append: plp_nav_parts[1]
          assign plp_nav_active = false
          for plp_nav_handle in plp_nav_parts
            if forloop.first
              continue
            endif
            if plp_nav_handle == blank
              continue
            endif
            if collections[plp_nav_handle] != empty
              assign plp_nav_url = collections[plp_nav_handle].url
              break
            endif
          endfor
          for plp_nav_handle in plp_nav_parts
            if forloop.first
              continue
            endif
            if collection.handle == plp_nav_handle
              assign plp_nav_active = true
            endif
          endfor
          if plp_nav_title == 'Jeans' and on_jeans_family
            assign plp_nav_active = true
          endif
        -%}
        <li class="collection-plp__menu-item">
          <a
            href="{{- plp_nav_url -}}"
            class="collection-plp__menu-link{% if plp_nav_active %} is-active{% endif %}"
            {% if plp_nav_active %}aria-current="page"{% endif %}
          >
            {{- plp_nav_title | escape -}}
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </nav>

  <div class="collection-plp__heading">
    <div class="collection-plp__title-row">
      <div class="collection-plp__title-wrap">
        <h1 class="collection-plp__title heading-static">{{- collection.title | escape -}}</h1>
        {%- if section.settings.enable_products_count -%}
          <span class="collection-plp__count" id="ProductCount">{{- product_count -}}</span>
        {%- endif -%}
      </div>

      {%- if enable_filtering or section.settings.enable_sorting -%}
        <button
          type="button"
          class="collection-plp__filter"
          id="CollectionPlpFilter-{{- section.id -}}"
          aria-haspopup="dialog"
          aria-controls="Filters-menu-drawer-{{- section.id -}}"
        >
          <span class="collection-plp__filter-icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
              <path d="M10 13.4404H4M15.56 13.4404H13.56" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"></path>
              <path d="M11.9986 15.0001C12.4137 15.0001 12.8117 14.8352 13.1052 14.5417C13.3987 14.2482 13.5636 13.8502 13.5636 13.4351C13.5636 13.0201 13.3987 12.622 13.1052 12.3285C12.8117 12.035 12.4137 11.8701 11.9986 11.8701C11.5835 11.8701 11.1855 12.035 10.892 12.3285C10.5985 12.622 10.4336 13.0201 10.4336 13.4351C10.4336 13.8502 10.5985 14.2482 10.892 14.5417C11.1855 14.8352 11.5835 15.0001 11.9986 15.0001Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
              <path d="M6 6.55957H4M15.69 6.55957H9.69" stroke="currentColor" stroke-linecap="square" stroke-linejoin="round"></path>
              <path d="M8.13141 8.13C8.54647 8.13 8.94453 7.96512 9.23803 7.67162C9.53152 7.37813 9.69641 6.98006 9.69641 6.565C9.69641 6.14994 9.53152 5.75187 9.23803 5.45838C8.94453 5.16488 8.54647 5 8.13141 5C7.71634 5 7.31828 5.16488 7.02478 5.45838C6.73129 5.75187 6.56641 6.14994 6.56641 6.565C6.56641 6.98006 6.73129 7.37813 7.02478 7.67162C7.31828 7.96512 7.71634 8.13 8.13141 8.13Z" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
          <span class="collection-plp__filter-text">{{- 'collection.plp.filter_sort' | t -}}</span>
          {%- if active_filter_count > 0 -%}
            <span class="collection-plp__filter-count">{{- active_filter_count -}}</span>
          {%- endif -%}
        </button>
      {%- endif -%}
    </div>

    {%- if on_jeans_family -%}
      <nav class="collection-plp__subs" aria-label="Jeans">
        <ul class="collection-plp__subs-list list-unstyled">
          {%- liquid
            assign jeans_sub_items = 'All Jeans|jeans||Slim fit jeans|slim-fit-jeans||Carpenter jeans|carpenter-jeans-men|carpenter-jeans||Spray on Jeans|spray-on-jeans||Relaxed fit jeans|relaxed-fit-jeans|relaxed-jeans' | split: '||'
          -%}
          {%- for jeans_sub_item in jeans_sub_items -%}
            {%- liquid
              assign jeans_sub_parts = jeans_sub_item | split: '|'
              assign jeans_sub_title = jeans_sub_parts | first
              assign jeans_sub_url = '/collections/' | append: jeans_sub_parts[1]
              assign jeans_sub_active = false
              for jeans_sub_handle in jeans_sub_parts
                if forloop.first
                  continue
                endif
                if jeans_sub_handle == blank
                  continue
                endif
                if collections[jeans_sub_handle] != empty
                  assign jeans_sub_url = collections[jeans_sub_handle].url
                  break
                endif
              endfor
              for jeans_sub_handle in jeans_sub_parts
                if forloop.first
                  continue
                endif
                if collection.handle == jeans_sub_handle
                  assign jeans_sub_active = true
                endif
              endfor
            -%}
            <li class="collection-plp__subs-item">
              <a
                href="{{- jeans_sub_url -}}"
                class="collection-plp__subs-link{% if jeans_sub_active %} is-active{% endif %}"
                {% if jeans_sub_active %}aria-current="page"{% endif %}
              >
                {{- jeans_sub_title | escape -}}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}
  </div>
</div>

<script>
  (function () {
    function syncPlpStickyOffset() {
      var group = document.querySelector('.shopify-section-group-header-group');
      var header = document.querySelector('.section-header');
      var headerHeight = group ? group.offsetHeight : (header ? header.offsetHeight : 66);
      document.documentElement.style.setProperty('--plp-sticky-top', headerHeight + 'px');
    }
    syncPlpStickyOffset();
    window.addEventListener('resize', syncPlpStickyOffset);
    window.addEventListener('load', syncPlpStickyOffset);
  })();
  document.getElementById('CollectionPlpFilter-{{ section.id }}')?.addEventListener('click', function () {
    const details = document.getElementById('Filters-drawer-{{ section.id }}');
    const summary = details?.querySelector('summary');
    if (summary) summary.click();
  });
</script>
