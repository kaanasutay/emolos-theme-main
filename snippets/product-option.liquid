{%- comment -%}
  Renders a product color swatch

  Accepts:
   - class {String}: Additional css classes for js or styling
   - input_class {String}: Additional css classes on the input element for js or styling
   - attr {String}: Additional HTML Attributes for accessability or js
   - id {String}: Input id
   - show_label {Bool}: Show input label
   - input_type: {String}: Input element type
   - value: {String}: Input element value
   - option {Object}: Product option drop (PDP colour photos)
   - product {Object}: Product drop (PDP colour photos)
{%- endcomment -%}
{%- liquid
  assign option_value_handle = value | handle
  assign class = class | default: ''
  assign input_class = input_class | default: ''
  assign attr = attr | default: ''
  assign id = id | default: option_value_handle
  assign input_type = input_type | default: 'radio'
  assign name = name | default: 'Swatch'
  assign visually_hidden = visually_hidden | default: true

  assign swatch_focal_point = null
  if value.swatch.image
    assign image_url = value.swatch.image | image_url: width: 50
    assign swatch_value = 'url(' | append: image_url | append: ')'
    assign swatch_focal_point = value.swatch.image.presentation.focal_point
  elsif value.swatch.color
    assign swatch_value = 'rgba(' | append: value.swatch.color.rgb | append: ' / var(--swatch-alpha, 1))'
  else
    assign swatch_value = null
  endif

  assign product_option_value = value
  if where == 'facets'
    assign product_option_value = value.value
  endif

  assign option_image = nil
  assign is_colour_image = false
  if where == 'product' and option != blank
    assign option_name_down = option.name | downcase
    assign swatch_name_down = settings.swatches_option | downcase
    if option_name_down == swatch_name_down or option_name_down == 'color' or option_name_down == 'colour'
      assign is_colour_image = true
      assign value_name = value.name | default: value
      if value.product.featured_image != blank
        assign option_image = value.product.featured_image
      elsif value.variant.featured_image != blank
        assign option_image = value.variant.featured_image
      elsif product != blank
        for variant in product.variants
          if option.position == 1 and variant.option1 == value_name and variant.featured_image != blank
            assign option_image = variant.featured_image
            break
          elsif option.position == 2 and variant.option2 == value_name and variant.featured_image != blank
            assign option_image = variant.featured_image
            break
          elsif option.position == 3 and variant.option3 == value_name and variant.featured_image != blank
            assign option_image = variant.featured_image
            break
          endif
        endfor
      endif
      if option_image == nil and value.swatch.image != blank
        assign option_image = value.swatch.image
      endif
    endif
  endif

  if option_image != nil
    assign swatch_value = null
    assign visually_hidden = true
  elsif swatch_value
    assign visually_hidden = 'false'
  endif

  assign size_num = ''
  assign size_len = ''
  assign option_label = value.label | default: value.name | strip
  if where == 'product' and option != blank
    assign size_option_down = option.name | downcase
    assign sizes_setting_down = settings.sizes_option | downcase
    if size_option_down == 'size' or size_option_down == sizes_setting_down
      if option_label contains ' '
        assign size_parts = option_label | split: ' '
        assign size_num = size_parts | first
        assign size_len = option_label | remove_first: size_num | strip
      elsif option_label contains '/'
        assign size_parts = option_label | split: '/'
        assign size_num = size_parts | first | strip
        assign size_len = size_parts | last | strip
      endif
      if size_len == blank
        assign size_num = ''
      endif
    endif
  endif
-%}

<div class="product-options__item{% if option_image != nil %} product-options__item--image product-options__item--colour-image{% elsif swatch_value %} product-options__item--swatch swatch--{{ settings.swatch_shape }}{% endif %}{% if class != '' %} {{ class }}{% endif %}"{% if swatch_value %} style="--swatch-background: {{ swatch_value }};{% if swatch_focal_point %} --swatch-focal-point: {{ swatch_focal_point }};{% endif %}"{% endif %}>
  <input
    id="{{- id -}}"
    type="{{- input_type -}}"
    name="{{- name -}}"
    class="product-options__input{% if input_class != '' %} {{ input_class }}{% endif %}{% unless visually_hidden == 'false' %} visually-hidden{% endunless %}"
    value="{{- product_option_value -}}"
    title="{{- product_option_value -}}"
    data-color="{{- product_option_value -}}"
    data-color-handle="{{- option_value_handle -}}"
    aria-label="{{- product_option_value -}}"
    {% if back_in_stock %}data-stock="back-in-stock"{% endif %}
    {% if variant_id %}data-variant="{{variant_id}}"{% endif %}
    {% if option_value_id %}data-option-value="{{ option_value_id }}"{% endif %}
    {{ attr }}
  />

  <span class="product-options__sizing-text" aria-hidden="true">{{- value.label | default: value.name | escape -}}</span>

  <label for="{{- id -}}" title="{{- value -}}" class="product-options__label">
    {%- if option_image != nil -%}
      <span class="visually-hidden">{{- value.label | default: value.name | escape -}}</span>
      <div class="media">
        {%- assign option_image_alt = value.label | default: value.name -%}
        {%- render 'image', image: option_image, width: 120, alt: option_image_alt -%}
      </div>
    {%- elsif size_num != blank and size_len != blank -%}
      <span class="size-num">{{- size_num | escape -}}</span>
      <span class="size-len">{{- size_len | escape -}}</span>
    {%- else -%}
      <span>{{- value.label | default: value.name | escape -}}</span>
    {%- endif -%}
  </label>
</div>
