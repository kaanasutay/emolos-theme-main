{%- comment -%}
  Accepts:

  - section {Section}
  - button_class {String}
  - button_prepend_text {String}
  - append_id {String}
{%- endcomment -%}

{% style %}
  .country-drawer__button-text,
  .header__utils-link span.country-drawer__button-text {
    display: flex;
    align-items: start;
    column-gap: 4px;
  }

  .localization-label {
    margin: 0 0 0.6rem;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }
{% endstyle %}

{% liquid
  assign country_flag = localization.country | image_url: width: 18 | image_tag

  capture button_text
    case settings.country_drawer_display_option
      when 'country-name--iso-code--currency-symbol'
        echo localization.country.name | append: ' | ' | append: localization.country.currency.iso_code | append: ' | ' | append: localization.country.currency.symbol
      when 'country-name--iso-code'
        echo localization.country.name | append: ' | ' | append: localization.country.currency.iso_code
      when 'country-name'
        echo localization.country.name
      when 'iso-code--currency-symbol'
        echo localization.country.currency.iso_code | append: ' | ' | append: localization.country.currency.symbol
      when 'flag'
        echo country_flag
      when 'flag--country-name'
        echo country_flag | append: ' ' | append: localization.country.name
      else
        echo localization.country.currency.iso_code
    endcase
  endcapture
%}

{%- if button_prepend_text -%}
  {%- assign button_text = button_text | prepend: ' ' | prepend: button_prepend_text -%}
{%- endif -%}

<details id="Country-drawer-{{- append_id -}}" class="drawer__container">
  <summary
    class="drawer__button drawer__button--text svg-color-inherit{{ button_class }}"
    id="Country-drawer-button-{{- append_id -}}"
    aria-label="{{- 'localization.title' | t -}}"
    tabindex="0"
  >
    <span class="drawer__button-text country-drawer__button-text" role="button">
      {{- button_text -}}
    </span>

    <noscript>
      {% render 'icon', icon_name: 'theme-arrow-close' %}
    </noscript>
  </summary>

  <div class="drawer__content js-drawer" id="Country-menu-drawer-{{- append_id -}}" tabindex="-1">
    <button
      class="drawer__button-close text-current button-reset no-js-hidden js-btn-close-drawer svg-color-inherit"
      aria-label="{{- 'actions.close' | t -}}"
      aria-controls="Country-menu-drawer-{{- append_id -}}"
      aria-expanded="false"
    >
      {% render 'icon', icon_name: 'theme-arrow-close' %}
    </button>

    <div class="drawer__row drawer__row--gutter-sm">
      {%- if settings.show_country_drawer_title -%}
        <h2 class="drawer__title heading-static">{{- 'localization.title' | t -}}</h2>
      {%- endif -%}
      {%- if settings.show_country_drawer_content -%}
        <p>{{- 'localization.content' | t -}}</p>
      {%- endif -%}
    </div>

    {%- if localization.available_countries.size > 1 or localization.available_languages.size > 1 -%}
      <div class="drawer__row">
        <localization-form>
          {% form 'localization' %}
            {% if localization.available_countries.size > 1 %}
              <div class="form-row">
                <p class="localization-label">Currency</p>
                <theme-dropdown class="theme-dropdown w-full" data-direction="down">
                  <button
                    type="button"
                    class="dropdown-button select-input__el"
                    id="country-drawer-selector-{{ append_id }}"
                  >
                    <span class="dropdown-button__text-content">
                      {{ localization.country.currency.iso_code }} - {{ localization.country.currency.symbol }}
                    </span>
                    {% render 'icon', icon_name: 'theme-chevron-down' %}
                  </button>

                  <div class="dropdown-content">
                    <ul class="slim-scrollbar">
                      {%- assign allowed_currencies = 'EUR,USD,CAD,GBP' | split: ',' -%}
                      {%- for currency_code in allowed_currencies -%}
                        {%- assign matched_country = blank -%}
                        {%- for country in localization.available_countries -%}
                          {%- if country.currency.iso_code == currency_code -%}
                            {%- assign matched_country = country -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if matched_country != blank -%}
                          {%- case currency_code -%}
                            {%- when 'EUR' -%}{%- assign currency_label = 'Euro (EUR - €)' -%}
                            {%- when 'USD' -%}{%- assign currency_label = 'US Dollar (USD - $)' -%}
                            {%- when 'CAD' -%}{%- assign currency_label = 'Canadian Dollar (CAD - CA$)' -%}
                            {%- when 'GBP' -%}{%- assign currency_label = 'British Pound (GBP - £)' -%}
                          {%- endcase -%}
                          <li class="{% if localization.country.iso_code == matched_country.iso_code %}is-active{% endif %}">
                            <a href="#" data-value="{{ matched_country.iso_code }}">
                              {{ currency_label }}
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>

                  <input
                    type="hidden"
                    name="country_code"
                    value="{{ localization.country.iso_code }}"
                  >
                </theme-dropdown>
              </div>
            {% endif %}

            {% if localization.available_languages.size > 1 %}
              <div class="form-row">
                <p class="localization-label">Language</p>
                <theme-dropdown class="theme-dropdown w-full" data-direction="down">
                  <button
                    type="button"
                    class="dropdown-button select-input__el"
                    id="country-drawer-language-{{ append_id }}"
                  >
                    <span class="dropdown-button__text-content">
                      {%- assign current_lang = localization.language.iso_code | slice: 0, 2 -%}
                      {%- case current_lang -%}
                        {%- when 'de' -%}German
                        {%- when 'fr' -%}French
                        {%- when 'es' -%}Spanish
                        {%- else -%}English
                      {%- endcase -%}
                    </span>
                    {% render 'icon', icon_name: 'theme-chevron-down' %}
                  </button>

                  <div class="dropdown-content">
                    <ul class="slim-scrollbar">
                      {%- assign allowed_languages = 'en,de,fr,es' | split: ',' -%}
                      {%- for lang_code in allowed_languages -%}
                        {%- assign matched_language = blank -%}
                        {%- for language in localization.available_languages -%}
                          {%- assign language_root = language.iso_code | slice: 0, 2 -%}
                          {%- if language_root == lang_code -%}
                            {%- assign matched_language = language -%}
                            {%- break -%}
                          {%- endif -%}
                        {%- endfor -%}
                        {%- if matched_language != blank -%}
                          {%- case lang_code -%}
                            {%- when 'en' -%}{%- assign language_label = 'English' -%}{%- assign language_flag = '🇺🇸' -%}
                            {%- when 'de' -%}{%- assign language_label = 'German' -%}{%- assign language_flag = '🇩🇪' -%}
                            {%- when 'fr' -%}{%- assign language_label = 'French' -%}{%- assign language_flag = '🇫🇷' -%}
                            {%- when 'es' -%}{%- assign language_label = 'Spanish' -%}{%- assign language_flag = '🇪🇸' -%}
                          {%- endcase -%}
                          <li class="{% if matched_language.iso_code == localization.language.iso_code %}is-active{% endif %}">
                            <a href="#" data-value="{{ matched_language.iso_code }}">
                              <span aria-hidden="true">{{ language_flag }}</span> {{ language_label }}
                            </a>
                          </li>
                        {%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>

                  <input
                    type="hidden"
                    name="language_code"
                    value="{{ localization.language.iso_code }}"
                  >
                </theme-dropdown>
              </div>
            {% endif %}

            <div class="form-row no-js">
              <button
                type="submit"
                class="button button--outlined button--full no-js"
              >
                {{ 'actions.submit' | t }}
              </button>
            </div>
          {% endform %}
        </localization-form>
      </div>

    {%- endif -%}
  </div>
</details>
