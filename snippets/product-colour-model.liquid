{%- comment -%}
  Model name used to keep sibling colours together.
  Strips a trailing colour from the product title.
  Accepts: title {String}
{%- endcomment -%}
{%- liquid
  assign model_key = title | downcase | replace: '–', '-' | replace: '—', '-' | strip
  for space_pass in (1..3)
    assign model_key = model_key | replace: ' - ', ' ' | replace: '  ', ' '
  endfor
  assign model_key = model_key | strip
  assign colour_suffixes = 'blue black wash|raw denim|dark blue|light blue|ice blue|stone blue|sky blue|dark grey|light grey|olive khaki|olive grey|soft sand|stone beige|washed grey|black|white|beige|khaki|ecru|navy|sand|grey|gray|stone|olive' | split: '|'

  for strip_pass in (1..3)
    assign colour_stripped = false
    for suffix in colour_suffixes
      assign suffix_marker = ' ' | append: suffix
      assign title_parts = model_key | split: suffix_marker
      assign title_tail = title_parts | last
      if title_parts.size > 1 and title_tail == blank
        assign model_key = ''
        for title_part in title_parts
          if title_part != blank
            if model_key != blank
              assign model_key = model_key | append: suffix_marker
            endif
            assign model_key = model_key | append: title_part
          endif
        endfor
        assign model_key = model_key | strip
        assign colour_stripped = true
        break
      endif
    endfor
    unless colour_stripped
      break
    endunless
  endfor

  echo model_key
-%}
