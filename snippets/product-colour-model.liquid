{%- comment -%}
  Base model name for sibling colours.
  Uses the title before " - " when present, then strips a trailing colour.
  Accepts: title {String}
{%- endcomment -%}
{%- liquid
  assign model_key = title | downcase | replace: '–', '-' | replace: '—', '-' | strip
  for space_pass in (1..3)
    assign model_key = model_key | replace: '  ', ' '
  endfor
  if model_key contains ' - '
    assign model_key = model_key | split: ' - ' | first | strip
  endif

  assign keep_ripped = false
  assign ripped_probe = model_key | append: '|'
  if ripped_probe contains ' ripped|'
    assign model_key = ripped_probe | split: ' ripped|' | first | strip
    assign keep_ripped = true
  endif

  assign colour_suffixes = 'washed black|vintage blue|blue black wash|raw denim|dark blue|light blue|ice blue|stone blue|sky blue|dark grey|light grey|olive khaki|olive grey|soft sand|stone beige|washed grey|dark green|light green|black|white|beige|khaki|ecru|cream|brown|green|navy|sand|grey|gray|stone|olive|blue|red' | split: '|'

  for strip_pass in (1..3)
    assign colour_stripped = false
    assign model_probe = model_key | append: '|'
    for suffix in colour_suffixes
      assign end_token = ' ' | append: suffix | append: '|'
      if model_probe contains end_token
        assign model_key = model_probe | split: end_token | first | strip
        assign colour_stripped = true
        break
      endif
    endfor
    unless colour_stripped
      break
    endunless
  endfor

  if keep_ripped
    assign model_key = model_key | append: ' ripped'
  endif

  echo model_key
-%}
