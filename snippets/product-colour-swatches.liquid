{%- comment -%}
  COLOUR photo links for products that are split by colour (separate products)
  rather than a Color variant option.
{%- endcomment -%}
{%- liquid
  assign has_colour_option = false
  for option in product.options_with_values
    assign option_name_down = option.name | downcase
    assign swatch_name_down = settings.swatches_option | downcase
    if option_name_down == swatch_name_down or option_name_down == 'color' or option_name_down == 'colour'
      if option.values.size > 1
        assign has_colour_option = true
      endif
    endif
  endfor

  assign colour_list = nil
  if product.metafields.custom.colour_group.value != blank
    assign colour_list = product.metafields.custom.colour_group.value
  elsif product.metafields.custom.color_group.value != blank
    assign colour_list = product.metafields.custom.color_group.value
  elsif product.metafields.custom.linked_products.value != blank
    assign colour_list = product.metafields.custom.linked_products.value
  endif

  assign colour_collection_handle = ''
  assign colour_match_best = 0
  assign product_type_key = product.type | downcase | strip
  assign generic_type_list = '|jacket|jackets|sweatpant|sweatpants|jean|jeans|short|shorts|pant|pants|hoodie|hoodies|t-shirt|tshirt|t shirt|shirt|jogger|joggers|'
  assign product_type_is_generic = false
  if generic_type_list contains '|' | append: product_type_key | append: '|'
    assign product_type_is_generic = true
  endif
-%}
{%- capture product_model_key -%}
  {%- render 'product-colour-model', title: product.title -%}
{%- endcapture -%}
{%- assign product_model_key = product_model_key | strip -%}

{%- if colour_list == blank and has_colour_option == false and product_type_key != blank -%}
  {%- for collection in product.collections -%}
    {%- assign colour_match_count = 0 -%}
    {%- for colour_product in collection.products -%}
      {%- assign colour_type_key = colour_product.type | downcase | strip -%}
      {%- if colour_type_key == product_type_key -%}
        {%- assign colour_model_ok = true -%}
        {%- if product_type_is_generic -%}
          {%- capture candidate_model_key -%}
            {%- render 'product-colour-model', title: colour_product.title -%}
          {%- endcapture -%}
          {%- assign candidate_model_key = candidate_model_key | strip -%}
          {%- if candidate_model_key == blank or candidate_model_key != product_model_key -%}
            {%- assign colour_model_ok = false -%}
          {%- endif -%}
        {%- endif -%}
        {%- if colour_model_ok -%}
          {%- assign colour_match_count = colour_match_count | plus: 1 -%}
        {%- endif -%}
      {%- endif -%}
    {%- endfor -%}
    {%- if colour_match_count > colour_match_best and colour_match_count < 16 -%}
      {%- assign colour_match_best = colour_match_count -%}
      {%- assign colour_collection_handle = collection.handle -%}
    {%- endif -%}
  {%- endfor -%}
{%- endif -%}

{%- unless has_colour_option -%}
  {%- capture colour_items -%}
    {%- if colour_list != blank -%}
      {%- for colour_product in colour_list -%}
        {%- if colour_product.featured_image -%}
          <a
            href="{{ colour_product.url }}"
            class="product-colour-swatches__item{% if colour_product.id == product.id %} is-active{% endif %}"
            title="{{ colour_product.title | escape }}"
          >
            <span class="media">
              {%- render 'image', image: colour_product.featured_image, width: 120, alt: colour_product.title -%}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- elsif colour_collection_handle != blank and colour_match_best > 1 -%}
      {%- assign colour_collection = collections[colour_collection_handle] -%}
      {%- for colour_product in colour_collection.products -%}
        {%- assign colour_is_match = false -%}
        {%- assign colour_type_key = colour_product.type | downcase | strip -%}
        {%- if colour_type_key == product_type_key -%}
          {%- assign colour_is_match = true -%}
          {%- if product_type_is_generic -%}
            {%- capture candidate_model_key -%}
              {%- render 'product-colour-model', title: colour_product.title -%}
            {%- endcapture -%}
            {%- assign candidate_model_key = candidate_model_key | strip -%}
            {%- if candidate_model_key == blank or candidate_model_key != product_model_key -%}
              {%- assign colour_is_match = false -%}
            {%- endif -%}
          {%- endif -%}
        {%- endif -%}
        {%- if colour_is_match and colour_product.featured_image -%}
          <a
            href="{{ colour_product.url }}"
            class="product-colour-swatches__item{% if colour_product.id == product.id %} is-active{% endif %}"
            title="{{ colour_product.title | escape }}"
          >
            <span class="media">
              {%- render 'image', image: colour_product.featured_image, width: 120, alt: colour_product.title -%}
            </span>
          </a>
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  {%- endcapture -%}

  {%- assign colour_item_count = colour_items | split: 'product-colour-swatches__item' | size | minus: 1 -%}
  {%- if colour_item_count > 1 -%}
    <fieldset class="product-options product-options--colour product-colour-swatches">
      <legend class="product-selector__label">COLOUR</legend>
      <div class="product-options__value-list">
        <div class="product-colour-swatches__list">
          {{ colour_items }}
        </div>
      </div>
    </fieldset>
    <hr class="product-info-divider not-in-quickbuy">
  {%- endif -%}
{%- endunless -%}
