{%- comment -%}
  Accepts:

  - menu {Linklist}
  - submenu {Linklist}
  - section {Section}
{%- endcomment -%}

<header-drawer class="drawer drawer--start header__drawer{% unless section.settings.layout == 'header--nav-drawer' %} mobile-drawer large-up-hide{% endunless %}">
  <details id="Navigation-drawer-{{- append_id -}}" class="drawer__container">
    <summary
      class="drawer__button svg-color-inherit"
      id="Navigation-drawer-button-{{- append_id -}}"
      aria-label="{{- 'actions.open_menu' | t -}}"
      tabindex="0"
    >
      {% render 'icon', icon_name: 'theme-menu' %}
      {% render 'icon', icon_name: 'theme-close' %}

      <noscript>
        {% render 'icon', icon_name: 'theme-arrow-close' %}
      </noscript>
    </summary>

    <div class="drawer__content js-drawer" id="Navigation-menu-drawer-{{- append_id -}}" tabindex="-1">
      <button
        class="drawer__button-close header-drawer__button-close svg-color-inherit button-reset small-hide medium-hide no-js-hidden js-btn-close-drawer"
        aria-label="{{- 'actions.close' | t -}}"
      >
        {% render 'icon', icon_name: 'theme-arrow-close' %}
      </button>

      <div class="mobile-menu large-up-hide">
        <div class="mobile-menu__bar">
          <div class="mobile-menu__search">
            {%- render 'search', input_id: 'mobile', placeholder: 'SEARCH...' -%}
          </div>

          <button
            type="button"
            class="mobile-menu__close button-reset js-btn-close-drawer"
            aria-label="{{- 'actions.close' | t -}}"
          >
            <svg width="16" height="14" viewBox="0 0 16 14" aria-hidden="true">
              <path d="M15 0L1 14m14 0L1 0" stroke="currentColor" fill="none"></path>
            </svg>
          </button>
        </div>
      </div>

      <div class="drawer__row drawer__row--gutter-lg mobile-menu__nav-row">
        <accordion-default class="accordion">
          <nav class="drawer__nav">
            <ul class="drawer__menu list-unstyled" role="list">
              {%- assign mobile_nav_items = 'All Products|all-products||New Arrivals|new-arrivals||Best Sellers|best-sellers||Jeans|jeans||Jackets|denim-jacket||Hoodies|hoodies||Joggers|joggers||T-Shirts|essential-t-shirt-men||Chino Pants|chino-pants||Polo Shirts|polo-shirt||Shorts|mens-denim-shorts||Cargo pants|cargo-pants-for-men' | split: '||' -%}
              {%- for mobile_nav_item in mobile_nav_items -%}
                {%- assign mobile_nav_parts = mobile_nav_item | split: '|' -%}
                {%- assign mobile_nav_title = mobile_nav_parts | first -%}
                {%- assign mobile_nav_handle = mobile_nav_parts | last -%}
                {%- assign mobile_nav_collection = collections[mobile_nav_handle] -%}
                {%- if mobile_nav_collection != empty -%}
                  {%- assign mobile_nav_href = mobile_nav_collection.url -%}
                {%- else -%}
                  {%- assign mobile_nav_href = '/collections/' | append: mobile_nav_handle -%}
                {%- endif -%}
                {%- assign mobile_nav_current = false -%}
                {%- if request.page_type == 'collection' and collection.handle == mobile_nav_handle -%}
                  {%- assign mobile_nav_current = true -%}
                {%- endif -%}
                <li class="drawer__menu-item">
                  <a href="{{- mobile_nav_href -}}" class="drawer__nav-link h4{% if mobile_nav_current %} is-current{% endif %}" {% if mobile_nav_current %}aria-current="page"{% endif %}>
                    {{- mobile_nav_title | escape -}}
                  </a>
                </li>
              {%- endfor -%}
            </ul>
          </nav>
        </accordion-default>
      </div>

      <div class="mobile-menu__footer large-up-hide">
        <localization-form class="mobile-menu__localization">
          {% form 'localization' %}
            {%- if localization.available_countries.size > 1 -%}
              <details class="mobile-menu__loc">
                <summary class="mobile-menu__loc-button">
                  <span class="mobile-menu__loc-text">
                    {{- localization.country.name }}
                    ({{ localization.country.currency.iso_code }}
                    {{ localization.country.currency.symbol }})
                  </span>
                  <svg class="mobile-menu__loc-caret" viewBox="0 0 19 12" width="10" height="6" aria-hidden="true">
                    <polyline fill="none" stroke="currentColor" points="17 2 9.5 10 2 2" stroke-width="2" stroke-linecap="square"></polyline>
                  </svg>
                </summary>
                <div class="mobile-menu__loc-list" role="list">
                  {%- assign allowed_currencies = 'EUR,USD,CAD,GBP' | split: ',' -%}
                  {%- for currency_code in allowed_currencies -%}
                    {%- assign matched_country = blank -%}
                    {%- for country in localization.available_countries -%}
                      {%- if country.currency.iso_code == currency_code -%}
                        {%- assign matched_country = country -%}
                        {%- break -%}
                      {%- endif -%}
                    {%- endfor -%}
                    {%- if matched_country != blank -%}
                      {%- case currency_code -%}
                        {%- when 'EUR' -%}{%- assign currency_label = 'Euro (EUR - €)' -%}
                        {%- when 'USD' -%}{%- assign currency_label = 'US Dollar (USD - $)' -%}
                        {%- when 'CAD' -%}{%- assign currency_label = 'Canadian Dollar (CAD - CA$)' -%}
                        {%- when 'GBP' -%}{%- assign currency_label = 'British Pound (GBP - £)' -%}
                      {%- endcase -%}
                      <button
                        type="submit"
                        name="country_code"
                        value="{{ matched_country.iso_code }}"
                        class="mobile-menu__loc-option{% if matched_country.iso_code == localization.country.iso_code %} is-active{% endif %}"
                      >
                        {{ currency_label }}
                      </button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </details>
              {%- if localization.available_languages.size > 1 -%}
                <details class="mobile-menu__loc">
                  <summary class="mobile-menu__loc-button">
                    <span class="mobile-menu__loc-text">Language</span>
                    <svg class="mobile-menu__loc-caret" viewBox="0 0 19 12" width="10" height="6" aria-hidden="true">
                      <polyline fill="none" stroke="currentColor" points="17 2 9.5 10 2 2" stroke-width="2" stroke-linecap="square"></polyline>
                    </svg>
                  </summary>
                  <div class="mobile-menu__loc-list" role="list">
                    {%- assign allowed_languages = 'en,de,fr,es' | split: ',' -%}
                    {%- for lang_code in allowed_languages -%}
                      {%- assign matched_language = blank -%}
                      {%- for language in localization.available_languages -%}
                        {%- assign language_root = language.iso_code | slice: 0, 2 -%}
                        {%- if language_root == lang_code -%}
                          {%- assign matched_language = language -%}
                          {%- break -%}
                        {%- endif -%}
                      {%- endfor -%}
                      {%- if matched_language != blank -%}
                        {%- case lang_code -%}
                          {%- when 'en' -%}{%- assign language_label = '🇺🇸 English' -%}
                          {%- when 'de' -%}{%- assign language_label = '🇩🇪 German' -%}
                          {%- when 'fr' -%}{%- assign language_label = '🇫🇷 French' -%}
                          {%- when 'es' -%}{%- assign language_label = '🇪🇸 Spanish' -%}
                        {%- endcase -%}
                        <button
                          type="submit"
                          name="language_code"
                          value="{{ matched_language.iso_code }}"
                          class="mobile-menu__loc-option{% if matched_language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                        >
                          {{ language_label }}
                        </button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                </details>
              {%- endif -%}
            {%- else -%}
              <span class="mobile-menu__loc-button">
                <span class="mobile-menu__loc-text">
                  {{- localization.country.name }}
                  ({{ localization.country.currency.iso_code }}
                  {{ localization.country.currency.symbol }})
                </span>
              </span>
            {%- endif -%}
          {% endform %}
        </localization-form>
      </div>
    </div>
  </details>
</header-drawer>
